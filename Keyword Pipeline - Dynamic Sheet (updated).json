        "jsCode": "const allLocationsData = [\n  { tabName: \"India\", geoId: \"2356\" },\n  { tabName: \"Maharashtra\", geoId: \"20462\" },\n  { tabName: \"Delhi\", geoId: \"20456\" },\n  { tabName: \"Uttar Pradesh\", geoId: \"20471\" },\n  { tabName: \"Karnataka\", geoId: \"20460\" },\n  { tabName: \"Tamil Nadu\", geoId: \"20469\" },\n  { tabName: \"Gujarat\", geoId: \"20457\" },\n  { tabName: \"West Bengal\", geoId: \"20472\" },\n  { tabName: \"Rajasthan\", geoId: \"20468\" },\n  { tabName: \"Andhra Pradesh\", geoId: \"20453\" },\n  { tabName: \"Telangana\", geoId: \"9061642\" },\n  { tabName: \"Kerala\", geoId: \"20461\" },\n  { tabName: \"Punjab\", geoId: \"20466\" },\n  { tabName: \"Haryana\", geoId: \"20458\" },\n  { tabName: \"Madhya Pradesh\", geoId: \"20464\" },\n  { tabName: \"Bihar\", geoId: \"20455\" },\n  { tabName: \"Odisha\", geoId: \"20465\" },\n  { tabName: \"Assam\", geoId: \"20454\" },\n  { tabName: \"Jharkhand\", geoId: \"21336\" },\n  { tabName: \"Uttarakhand\", geoId: \"21341\" },\n  { tabName: \"Himachal Pradesh\", geoId: \"21335\" },\n  { tabName: \"Goa\", geoId: \"21268\" },\n  { tabName: \"Manipur\", geoId: \"21337\" },\n  { tabName: \"Meghalaya\", geoId: \"20463\" },\n  { tabName: \"Mizoram\", geoId: \"21338\" },\n  { tabName: \"Nagaland\", geoId: \"21339\" },\n  { tabName: \"Sikkim\", geoId: \"21340\" },\n  { tabName: \"Tripura\", geoId: \"20470\" },\n  { tabName: \"Arunachal Pradesh\", geoId: \"21289\" },\n  { tabName: \"Chandigarh\", geoId: \"21342\" },\n  { tabName: \"Puducherry\", geoId: \"20467\" },\n  { tabName: \"Dadra & Nagar Havelli\", geoId: \"21343\" },\n  { tabName: \"Bengaluru\", geoId: \"1007768\" },\n  { tabName: \"Delhi NCR\", geoId: \"20456\" },\n  { tabName: \"CMR\", geoId: \"1007809\" }, // Mapped to Chennai\n  { tabName: \"Hyderabad\", geoId: \"1007740\" },\n  { tabName: \"MMR\", geoId: \"1007785\" }, // Mapped to Mumbai\n  { tabName: \"PMR\", geoId: \"1007788\" }, // Mapped to Pune\n  { tabName: \"KMR\", geoId: \"1007828\" }, // Mapped to Kolkata\n  { tabName: \"AMR\", geoId: \"1007753\" }, // Mapped to Ahmedabad\n  { tabName: \"Jaipur\", geoId: \"1007805\" },\n  { tabName: \"Lucknow\", geoId: \"1007824\" },\n  { tabName: \"Coimbatore\", geoId: \"1007810\" },\n  { tabName: \"Indore\", geoId: \"1007796\" },\n  { tabName: \"Kochi\", geoId: \"1007776\" },\n  { tabName: \"Ernakulam\", geoId: \"9040212\" },\n  { tabName: \"Thiruvananthapuram\", geoId: \"1007779\" },\n  { tabName: \"Nagpur\", geoId: \"1007786\" }\n];\n\nconst cfg = $('Config').item.json;\nconst filtered = cfg.allLocations\n  ? allLocationsData\n  : allLocationsData.filter(loc => cfg.locations.includes(loc.tabName));\n\nif (filtered.length === 0) {\n  throw new Error('allLocations is false but none of the requested locations matched a known tabName.');\n}\n\nreturn filtered.map(loc => ({ json: loc }));"
