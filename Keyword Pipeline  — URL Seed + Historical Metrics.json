    {
      "parameters": {
        "jsCode": "const newItems = [];\n// Grab the website from the current loop iteration\nconst currentWebsite = $('Loop Over Items').item.json.website;\n\nfor (const item of $input.all()) {\n  const results = item.json.results || [];\n  \n  // Take top 500 keywords per URL\n  const topKeywords = results.slice(0, 100);\n  \n  for (const result of topKeywords) {\n    // Attach the website to the keyword object\n    result.Website = currentWebsite;\n    \n    newItems.push({\n      json: result\n    });\n  }\n}\n\nreturn newItems;"
      },
